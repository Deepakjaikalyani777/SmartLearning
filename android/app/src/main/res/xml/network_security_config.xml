<?xml version="1.0" encoding="utf-8"?>
<!-- Security: HTTPS only, trust only system CAs (not user-installed CAs).
     See docs/04_Flutter_App_Security_Guide.pdf -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
